{
  "name": "two-pizzas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp-hashes.mjs",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"core/test/*.test.ts\" \"app/i18n/test/*.test.ts\" \"app/game/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "node scripts/check-dist.mjs",
    "test:all": "npm test && npm --prefix worker test && node --test scripts/check-dist.test.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.4.1",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
