{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["app", "core", ".astro/types.d.ts"],
  "exclude": ["dist", "reference", "worker", "node_modules"]
}
