---
import Base from '../layouts/Base.astro';
import { App } from '../game/App.tsx';
import { createT } from '../i18n/index.ts';

const en = createT('en');
const ro = createT('ro');
---

<Base title="Two Pizzas" lang="ro" description={ro('start.tagline')} skipLabel={ro('a11y.skip')}>
  <App client:only="preact" />
  <noscript>
    <p class="lg-page lg-main">{ro('shell.noscript')}</p>
    <p class="lg-page lg-main">{en('shell.noscript')}</p>
  </noscript>
</Base>
