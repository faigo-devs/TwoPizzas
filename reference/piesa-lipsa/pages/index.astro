---
import Sheet from '../layouts/Sheet.astro';
import { texts } from '../game/texts.mjs';
import { setupView } from '../game/views.mjs';
---

<Sheet title={texts.metaTitle} description={texts.metaDescription} canonical="https://www.faigo.ro/">
  <div class="wrap">
    <section class="sec" aria-labelledby="t-game">
      <div class="sec-head">
        <span class="sec-tick" aria-hidden="true"></span>
        <h1 class="sec-title" id="t-game">{texts.title}</h1>
        <span class="sec-tick end" aria-hidden="true"></span>
      </div>
      <p class="sec-sub">{texts.intro}</p>
      <noscript><p class="note">{texts.noScript}</p></noscript>
      <div id="game" set:html={setupView()} />
    </section>
    <section class="sec" aria-labelledby="t-how">
      <div class="sec-head">
        <span class="sec-tick" aria-hidden="true"></span>
        <h2 class="sec-title" id="t-how">{texts.howTitle}</h2>
        <span class="sec-tick end" aria-hidden="true"></span>
      </div>
      <ol class="chain">
        {texts.how.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Sheet>

<script>
  import { startGame } from '../game/app.mjs';

  const root = document.getElementById('game');
  if (root) startGame(root);
</script>
